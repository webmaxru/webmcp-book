// Azure infrastructure for the web edition of "Tools, Not Clicks" (the WebMCP book).
//
//   - One Azure Static Web App on the FREE plan (no hosting bill). It serves the static
//     site that `python3 tools/build.py site` writes to dist/site/.
//   - No repository link: content is uploaded with the app's deployment token (by
//     infra/deploy.sh / deploy.ps1 and by .github/workflows/deploy-swa.yml). The site
//     therefore does not depend on the repo being public, on GitHub Pages, or on the
//     Azure GitHub app's permissions.
//   - Optional: the custom domain (parameter customDomain, e.g. webmcp.salnikov.no).
//     The CNAME record must exist BEFORE you set it, see CUSTOM-DOMAIN.md.
//   - Optional: a monthly Consumption budget with email alerts (budget.bicep).
//
// Deploy with ./infra/deploy.sh (or infra/deploy.ps1), or directly:
//   az group create -n rg-webmcp-book -l westeurope
//   az deployment group create -g rg-webmcp-book -f infra/main.bicep

targetScope = 'resourceGroup'

@description('Name of the Static Web App: 2-40 characters, letters, digits and hyphens. It is part of the portal URL only; the public hostname is generated by Azure.')
@minLength(2)
@maxLength(40)
param swaName string = 'swa-webmcp-book'

@description('Region that holds the Static Web App resource. Static content is served from a global edge either way. Static Web Apps accepts only these regions; West Europe is the closest to Norway.')
@allowed([
  'westeurope'
  'eastus2'
  'centralus'
  'westus2'
  'eastasia'
])
param location string = 'westeurope'

@description('Custom domain to bind, e.g. webmcp.salnikov.no. A CNAME from this name to the app\'s default hostname must already resolve publicly (DNS only, not proxied). Empty = no custom domain.')
param customDomain string = ''

@description('Email for the budget alerts. Empty = no budget is created.')
param budgetContactEmail string = ''

@description('Monthly budget amount, in the billing currency of the subscription. The Free plan costs 0; the budget is only a safety net.')
@minValue(1)
param budgetAmount int = 1

@description('Name of the budget.')
param budgetName string = 'budget-webmcp-book'

@description('First day of the budget period (yyyy-MM-01). Keep the same value on re-deploys; deploy.sh reuses the existing budget\'s start date.')
param budgetStartDate string = utcNow('yyyy-MM-01')

@description('Tags for the created resources.')
param tags object = {
  project: 'webmcp-book'
  purpose: 'book-web-edition'
  managedBy: 'bicep'
}

resource swa 'Microsoft.Web/staticSites@2024-04-01' = {
  name: swaName
  location: location
  tags: tags
  sku: {
    name: 'Free'
    tier: 'Free'
  }
  properties: {
    // No repositoryUrl / branch / repositoryToken on purpose: uploads use the deployment token.
    allowConfigFileUpdates: true
    // Preview environments come from pull requests of a linked repo; there is none.
    stagingEnvironmentPolicy: 'Disabled'
  }
}

// The Free plan includes 2 custom domains with free, auto-renewing managed certificates.
// 'cname-delegation' validates a subdomain through its CNAME record (an apex domain would
// need 'dns-txt-token' instead, see CUSTOM-DOMAIN.md).
resource domain 'Microsoft.Web/staticSites/customDomains@2024-04-01' = if (!empty(customDomain)) {
  parent: swa
  name: empty(customDomain) ? 'none' : customDomain
  properties: {
    validationMethod: 'cname-delegation'
  }
}

module budget 'budget.bicep' = if (!empty(budgetContactEmail)) {
  name: 'budget-${swaName}'
  params: {
    budgetName: budgetName
    amount: budgetAmount
    contactEmail: budgetContactEmail
    startDate: budgetStartDate
  }
}

@description('Name of the Static Web App.')
output name string = swa.name

@description('Default hostname, e.g. nice-sea-0123abc.6.azurestaticapps.net. Point the custom domain\'s CNAME here.')
output defaultHostname string = swa.properties.defaultHostname

@description('Resource id of the Static Web App.')
output id string = swa.id

@description('Custom domain bound by this deployment (empty = none).')
output customDomain string = customDomain

@description('Whether a budget was created or updated.')
output budgetCreated bool = !empty(budgetContactEmail)
